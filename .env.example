# MixMarket Umgebungsvariablen (Vorlage)
# Diese Datei nach server/.env kopieren und bei Bedarf anpassen.
# Die .env-Datei wird niemals committet.

# --- Server ---
# Port des Backend-API-Servers
PORT=5260
# Umgebung: development oder production
NODE_ENV=development
# Oeffentliche Basis-URL des Backends (fuer Tracking- und Abmelde-Links)
PUBLIC_API_URL=http://localhost:5260
# Oeffentliche Basis-URL des Frontends (fuer Redirects und die Herkunftspruefung)
PUBLIC_WEB_URL=http://localhost:5261
# Netzwerkschnittstelle des Servers. Standard: nur dieser Rechner (127.0.0.1).
# 0.0.0.0 nur setzen, wenn MixMarket direkt aus dem Netz erreichbar sein soll (z. B. in Docker).
HOST=127.0.0.1
# Adresse des eigenen Reverse-Proxys (z. B. 127.0.0.1), nur dann wird X-Forwarded-For vertraut.
# Leer lassen, wenn kein Reverse-Proxy davor steht.
TRUST_PROXY=

# --- Sicherheit ---
# Geheimer Schluessel fuer die Anmeldung. Leer lassen: MixMarket erzeugt beim ersten Start einen
# zufaelligen Schluessel (server/prisma/mixmarket.secret). Eigener Wert: mindestens 32 zufaellige Zeichen.
JWT_SECRET=
# Gueltigkeitsdauer der Anmeldung
JWT_EXPIRES_IN=7d
# Schluessel fuer gespeicherte Zugangsdaten der Suchquellen (DataForSEO, Serper).
# Leer lassen, dann wird JWT_SECRET verwendet. Aendert er sich, muessen die
# Zugaenge in den Einstellungen neu eingetragen werden.
SECRETS_KEY=

# --- Datenbank ---
# SQLite-Datei; relative Pfade gelten ab dem Ordner server/prisma/
DATABASE_URL="file:./dev.db"

# --- E-Mail-Versand (SMTP) ---
# Diese Werte stammen von Ihrem Mail-Anbieter. Sie lassen sich auch in der App unter
# Einstellungen, Postfach eintragen. Ohne Zugang laeuft MixMarket im Testmodus.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Absenderadresse und Anzeigename
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=MixMarket

# --- MixMarket Pro ---
# Nur für die Entwicklung, im Betrieb leer lassen.
MIXMARKET_LICENSE_URL=

# --- Versand-Drosselung (Schutz der Zustellbarkeit) ---
# Maximale Anzahl Mails pro Stunde
SEND_RATE_PER_HOUR=200
# Pause zwischen einzelnen Mails in Millisekunden
SEND_DELAY_MS=1500
