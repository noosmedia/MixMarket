{
  "name": "@mixmarket/server",
  "version": "0.17.0",
  "description": "MixMarket Backend-API",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:push": "prisma db push",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "reset-password": "tsx src/scripts/reset-password.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "imapflow": "^2.5.2",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.2",
    "playwright": "^1.49.1",
    "postal-mime": "4.0.5",
    "undici": "^7.30.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "prisma": "^7.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
